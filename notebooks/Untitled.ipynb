    "import ollama\n",
    "\n",
    "response = ollama.chat(\n",
    "    model=\"llama3.2:3b\",\n",
    "    messages=[\n",
    "        {\n",
    "            \"role\": \"user\",\n",
    "            \"content\": \"Explain financial research in two sentences.\"\n",
    "        }\n",
    "    ]\n",
    ")\n",
    "\n",
    "print(response[\"message\"][\"content\"])"
   ]
  }
